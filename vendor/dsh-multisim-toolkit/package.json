{
  "name": "dsh-multisim-toolkit",
  "version": "0.1.0",
  "private": true,
  "description": "Drive the local NI Multisim 14.3 install from DSH: COM automation for schematic/simulation work plus a Win32 GUI channel for netlist drops and screenshots.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "icon": "icon.svg",
  "files": [
    "index.js",
    "lib",
    "worker",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
